# ── Anthropic Claude (판단 로직 LLM) ─────────────────────────────
# 프로토타입은 Claude Sonnet 5 단일 모델만 사용한다.
# 키는 절대 코드/이미지에 하드코딩하지 말고 이 환경변수로만 주입한다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# ── Voyage AI (임베딩 후보 필터 전용) ────────────────────────────
# Anthropic은 임베딩 API가 없어 별도 모델 사용. https://www.voyageai.com 에서 발급.
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=voyage-3

# ── PostgreSQL + pgvector ────────────────────────────────────────
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot
POSTGRES_DB=copilot
# 앱이 사용하는 접속 URL (docker-compose 네트워크 기준: host=db)
DATABASE_URL=postgresql+asyncpg://copilot:copilot@db:5432/copilot

# API를 노출할 호스트 포트 (기본 8000). 이미 쓰이면 바꾼다.
# API_PORT=8000
# 하루 LLM 토큰 예산 (입력+출력, 0이면 무제한)
DAILY_TOKEN_BUDGET=2000000
# 웹을 노출할 호스트 포트 (기본 3000)
# WEB_PORT=3000
# 자료 길이 상한(글자). 넘으면 분석 전에 거절한다.
# MAX_CONTENT_CHARS=60000
